# Cloud Run with a direct managed Postgres connection

PORT=8080
NODE_ENV=production
DATA_SOURCE=sql

# Direct connection to Neon / Cloud SQL (use Secret Manager)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dashboard_db?sslmode=require

# Optional seed (first boot only — ON CONFLICT DO NOTHING)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrator

# Firebase Admin + other secrets should come from Secret Manager.

# Rate-card change notifications (store the API key in Secret Manager).
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Payments <alerts@your-verified-domain.com>
# RATE_CARD_NOTIFICATION_TO=payments@youthnic.shop
