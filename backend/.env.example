# Backend local / server env template - copy to backend/.env
PORT=3001
NODE_ENV=development
DATA_SOURCE=sql
# Comma-separated browser origins. Required for a production static frontend;
# local/private-LAN origins remain allowed only while NODE_ENV is not production.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Canonical PostgreSQL connection to paymentapp on Hostinger VPS.
# Production API containers should use the private Docker alias, not the VPS
# public IP/port.
# Encode $ in passwords as %24.
DATABASE_URL=postgresql://pawanshukla:PASSWORD@postgres:5432/paymentapp
PG_SSL=false
# For local Windows development, prefer the SSH tunnel:
# DATABASE_URL=postgresql://pawanshukla:PASSWORD@127.0.0.1:5432/paymentapp
# PG_SSL=false
# For an unavoidable public database endpoint, enable TLS and certificate
# verification instead of using the private Docker setting.
# PG_SSL=true
# PG_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=20
PG_POOL_MIN=2
PG_POOL_IDLE_TIMEOUT_MS=55000
PG_POOL_MAX_LIFETIME_SECONDS=900
PG_APPLICATION_NAME=reconcentral-api
# Bound ordinary dashboard/report SQL. Atomic upload/rebuild transactions clear
# this session timeout only for their own connection.
PG_READ_STATEMENT_TIMEOUT_MS=45000
# Ping the database in the background so an interrupted remote connection
# starts recovering even when no user request is currently running.
PG_HEALTHCHECK_INTERVAL_MS=25000

# Optional one-time admin seed (ON CONFLICT DO NOTHING — does not reset password)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrator

# Firebase Admin (service account JSON path or inline)
# GOOGLE_APPLICATION_CREDENTIALS=

# AI (optional)
# NVIDIA_API_KEY=
# GEMINI_API_KEY=

# Rate-card change notifications (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Payments <alerts@your-verified-domain.com>
# RATE_CARD_NOTIFICATION_TO=payments@youthnic.shop
