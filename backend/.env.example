# Backend local / server env template — copy to backend/.env
PORT=3001
NODE_ENV=development
DATA_SOURCE=sql
# Comma-separated browser origins. Required for a production static frontend;
# local/private-LAN origins remain allowed only while NODE_ENV is not production.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Prefer DATABASE_URL (encode $ in password as %24)
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5433/dashboard_db?sslmode=disable&connect_timeout=15

PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=dashboard_db
PG_USER=postgres
PG_PASSWORD=
# Local development may use false. Production connections to any non-local
# PostgreSQL host fail closed unless TLS is explicitly enabled.
PG_SSL=false
# TLS certificate verification defaults to true whenever PG_SSL=true. Set this
# to false only for a provider-specific, temporary compatibility exception.
# PG_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA, with newlines written as \n in an environment variable.
# PG_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
PG_POOL_MAX=20
PG_POOL_MIN=0
PG_APPLICATION_NAME=reconcentral-api
# Recycle remote PostgreSQL connections before network devices can leave stale sockets.
PG_POOL_MAX_LIFETIME_SECONDS=600
# Bound ordinary dashboard/report SQL. Atomic upload/rebuild transactions clear
# this session timeout only for their own connection.
PG_READ_STATEMENT_TIMEOUT_MS=90000
# Ping the database in the background so an interrupted remote connection
# starts recovering even when no user request is currently running.
PG_HEALTHCHECK_INTERVAL_MS=30000

# Optional one-time admin seed (ON CONFLICT DO NOTHING — does not reset password)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrator

# Firebase Admin (service account JSON path or inline)
# GOOGLE_APPLICATION_CREDENTIALS=

# AI (optional)
# NVIDIA_API_KEY=
# GEMINI_API_KEY=

# Rate-card change notifications (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Payments <alerts@your-verified-domain.com>
# RATE_CARD_NOTIFICATION_TO=payments@youthnic.shop
